# 文档引擎类型。
# 可用选项：
# - `elasticsearch`（默认）
# - `infinity`
DOC_ENGINE=elasticsearch

# Elasticsearch
STACK_VERSION=8.17.3
ES_HOST=
ES_PORT=9200
ES_USER=elastic
ELASTIC_PASSWORD=

# 元数据库类型
DB_TYPE=postgres

# PostgreSQL
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DBNAME=

# Redis
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# 后端的 HTTP 端口
SVR_HTTP_PORT=9380

# 本地时区
TIMEZONE='Asia/Shanghai'

# 如果无法访问 huggingface.co，请取消以下注释：
# HF_ENDPOINT=https://hf-mirror.com

# MacOS 优化
# MACOS=1

# 每个上传文件的最大大小（以字节为单位）。
# 如果需要更改默认的 1G 文件大小限制，可以取消以下注释并调整值：
# MAX_CONTENT_LENGTH=1073741824
# 修改后，请确保在 `nginx/nginx.conf` 中更新 `client_max_body_size`。
# 注意，这两个设置对agent中的文件上传无效
# See https://ragflow.io/docs/dev/begin_component for details.

# RAGFlow 自有包和导入包的日志级别。
# 可用级别：
# - `DEBUG`
# - `INFO`（默认）
# - `WARNING`
# - `ERROR`
# For example, following line changes the log level of `ragflow.es_conn` to `DEBUG`:
# LOG_LEVELS=ragflow.es_conn=DEBUG

# 阿里云 OSS 配置
STORAGE_IMPL=OSS
ACCESS_KEY=
SECRET_KEY=
ENDPOINT=http://oss-cn-hangzhou.aliyuncs.com
REGION=cn-hangzhou
BUCKET=
OSS_PREFIX_PATH=

# 并发对话
MAX_CONCURRENT_CHATS=5

# 允许用户注册
REGISTER_ENABLED=1